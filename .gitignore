# Codex P1.0 processor ledgers (会持续追加, 不应该 commit)
data/research_framework/decisions.jsonl
data/research_framework/processed_claude_messages.jsonl
data/research_framework/runs.jsonl
data/research_framework/tried_directions.jsonl
data/research_framework/hermes_access_audit.jsonl

# research-question-lifecycle 那批持续追加的 ledger + 运行时锁文件（2026-08-22 补，
# 跟上面同一条规矩：会持续追加，不应该 commit；.lock 是运行期互斥锁，本来就不该进版本控制）
data/research_framework/lifecycle_projection_diffs.jsonl
data/research_framework/research_input_admission_history.jsonl
data/research_framework/research_question_events.jsonl
data/research_framework/*.lock
# Sidecar mutex files for the shared JSONL ledger writer
# (framework/autonomous/jsonl_ledger.py). Run-local verification logs are
# tracked, but their runtime locks must never be committed.
*.jsonl.lock

# Heavy generated batch artifacts (按 repo audit 2026-05-16 加)
# 大批量回测产生的中间结果, 不进 git. 只 promote summary/manifest 进 git
data/cb_arb_concurrent_supervised_*/
data/cb_arb_rerun_*/
data/cb_arb_*_2026-*/**/*.parquet
data/cb_arb_*/vm_*.log
data/cb_arb_*/spot_*.log
data/cb_arb_*/*.pid
data/cb_arb_*/heartbeat
*.pid

# research-question-lifecycle 单次 admission 的工作目录（2026-08-22 补，同一条规矩：
# 只 promote data/research_framework/run_manifests/*.yaml 进 git，原始工作目录不进）
data/research_input_*/
data/research_framework/admission_packets/

# Archive (保留物理副本但不 commit)
archive/
.framework-watch.pid

# Runtime state (not source)
data/research_framework/orchestrator_paused.flag
logs/research_queue_status.json

# 一次性研究诊断的产出目录（study/<name>/），跟上面「大批量生成产物不进 git」同一条规矩：
# 脚本 study/*.py 读 data/ 里的仓库数据、可完整复现这些 CSV/PNG/REPORT.txt，所以只 commit
# 脚本本身，不 commit 产出。注意 scripts/validate_entrypoints.py 是扫文件系统而不是扫 git，
# 所以 gitignore 挡不住 markdown 禁令：study 下的散文一律用 .txt（同 docs/QUANT_WORKFLOW.txt）。
study/*/
